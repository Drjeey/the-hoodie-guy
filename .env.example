# .env.example - copy this to .env.local and fill in values
# Never commit .env.local

# Email service (Resend or Nodemailer)
RESEND_API_KEY=your_key_here

# Business contact (used in custom order notifications)
BUSINESS_EMAIL=your@email.com
BUSINESS_WHATSAPP=+254XXXXXXXXX

# Optional: Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
